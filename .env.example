# Runtime
NODE_ENV=development

# Pipeline
PIPELINE_MAX_ITERATIONS=5
PROCESS_TIMEOUT_MS=600000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=web_sub_agent

# Generated apps
FRONTEND_PORT=3000
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/web_sub_agent
